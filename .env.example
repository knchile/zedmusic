# Zed Music Online — environment variables
# Copy to .env (local) and set the same names in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Generate secrets with:  openssl rand -base64 32

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
# Neon pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/zedmusic?sslmode=require
# Neon direct (non-pooled) connection string. Used only for migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/zedmusic?sslmode=require
# Session/auth signing secret (32+ random bytes).
BETTER_AUTH_SECRET=
# Canonical public URL, no trailing slash. Production: https://www.zedmusic.online
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google sign-in (optional). Redirect URI: <APP_URL>/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3-compatible). Required for uploads (Phase 2).
# ---------------------------------------------------------------------------
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for audio (no public access).
S3_AUDIO_BUCKET=zedmusic-audio
# Bucket for artwork and profile images, exposed through a custom domain.
S3_MEDIA_BUCKET=zedmusic-media
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.zedmusic.online

# ---------------------------------------------------------------------------
# Email — Resend. Without it, sign-up confirmation emails cannot be delivered in production.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Zed Music Online <no-reply@zedmusic.online>"

# ---------------------------------------------------------------------------
# Scheduled jobs (Phase 3+). Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Analytics & anti-fraud (Phase 3). Changing these breaks continuity of unique-listener counts.
# ---------------------------------------------------------------------------
ANALYTICS_HASH_SECRET=
PLAY_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Encryption key for third-party OAuth tokens at rest (Phase 5). 32 bytes, base64.
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# External platforms (Phase 5, all optional). See docs/EXTERNAL-INTEGRATIONS.md
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Permit `npm run db:seed -- --demo` (always refused when NODE_ENV=production).
ALLOW_DEMO_DATA=false
# Disposable database for `npm run test:integration` (it is wiped on every run).
TEST_DATABASE_URL=
